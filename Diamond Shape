    public static void main(String[] args){
        int n = 5;
       //Upper Half
        for(int i=1;i<=n;i++){
            //1st stars
            for(int j=n;j>i;j--){
            System.out.print( "  "); 
           }
           //spaces
           for(int k=1;k<=2*i-1;k++){
            System.out.print("* " );
           }
            System.out.println();
        }
        //Lower Half
         for(int i=n-1;i>=1;i--){
            //spaces
            for(int j=1;j<=n-i;j++){
            System.out.print( "  "); 
           }
           //stars
           for(int k=1;k<=2*i-1;k++){
            System.out.print("* " );
           }
            System.out.println();
        } 
    }
}
