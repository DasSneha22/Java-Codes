import java.util.Scanner;
//Span of Array
public class arrays {
    public static void main(String args[]){
        int arr[] = new int[5];
        Scanner scn = new Scanner(System.in);      
        for(int i = 0;i<arr.length;i++){
            arr[i] = scn.nextInt();
        } 
        int min = arr[0];
        int max = arr[0];
        for(int i =0;i<arr.length;i++){
        if(arr[i]>max){
            max = arr[i];
        }
       if(arr[i]<min){
            min = arr[i];
        }
    }
        
     int span = max - min;
     System.out.println(span);
     scn.close();
}
}
