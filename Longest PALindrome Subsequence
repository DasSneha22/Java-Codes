import java.util.*;
public class LongestPalindrome {
public static String SubsequentString(String a){
int len1,len2;
int maxLength = 0;//defines length of the Palindromic Sequence
int start=0;
int end= 0;;//defines start and end of the Palindromic Subsequence
 if(a == null || a.length()<1) return "";
for(int i=0;i<a.length();i++){
    
    len1 = expandfronCentre(a, i, i);//for odd sequnce
    len2 = expandfronCentre(a, i, i+1);//for even sequence
    maxLength = Math.max(len1 , len2);
    
    if(maxLength>(end-start)){
    start = i - (maxLength-1)/2;
    end = i + maxLength/2;
    }
    

}
return a.substring(start ,end+1);
}
public static int expandfronCentre(String s,int left,int right){
    while(left>=0 && right<s.length() && s.charAt(left)==s.charAt(right)){
        left --;
        right ++;
    }
    return right-left-1;
}
public static void main(String[] args){
   System.out.println("Enter the string to check for the longest palindromic sequence: ");
    Scanner scn = new Scanner(System.in);
    String s = scn.nextLine();
    String r = SubsequentString(s);
    System.out.println("The longest palindromic subsequence: "+ r);
    scn.close();
}
}
