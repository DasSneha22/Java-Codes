    public static void main(String[] args){
        int n = 6;
       //Upper Half
        for(int i=1;i<=n;i++){
            //1st stars
            for(int j=1;j<=i;j++){
            System.out.print( "*"); 
           }
           //spaces
           for(int k=1;k<=2*(n-i);k++){
            System.out.print(" " );
           }
           //2nd stars
           for(int j=1;j<=i;j++){
            System.out.print( "*"); 
           }
            System.out.println();
        }
        //Lower Half
         for(int i=n;i>=1;i--){
            //1st stars
            for(int j=1;j<=i;j++){
            System.out.print( "*"); 
           }
           //spaces
           for(int k=1;k<=2*(n-i);k++){
            System.out.print(" " );
           }
           //2nd stars
           for(int j=1;j<=i;j++){
            System.out.print( "*"); 
           }
            System.out.println();
        }
    }
}
