import java.util.*;
public class subtraction {
    public static int getDifference(int n1,int n2,int b){
     int x;
     int y;
      int net = 0;
    if(n1>n2){
     x = n1;
     y = n2;
     }else{
     x = n2;
     y = n1;
     }
     int i=0;
     int borrow = 0;
     int d=0 ;
     while(x>0 || y>0){
     int d1 = x%10;
     int d2 = y%10;
     x = x/10;
     y = y/10;
     if(d1+borrow < d2){
      d = d1 + b + borrow - d2;
      borrow = -1;
     }else{
      d = d1 + borrow -d2;
      borrow = 0;
     }
     net = net + d*(int)Math.pow(10,i);
     i++;
     }
     return (net);
    }
public static void main(String args[]){
    Scanner scn = new Scanner(System.in);
    System.out.println("Enter 1st number: ");
    int n1 = scn.nextInt();
    System.out.println("Enter 2nd number: ");
    int n2 = scn.nextInt();
    System.out.println("Enter base ");
    int b = scn.nextInt();
    System.out.println("The subtraction result is: "+getDifference(n1, n2, b));
    scn.close();
}
}
