import java.util.*;
public class stacks {
    public static void main(String args[]){
        Stack<Integer> st = new Stack<>();
        st.push(16);
        st.push(05);
        st.push(22);
        st.push(10);
        st.push(31);
        System.out.println(st);
        st.pop();
        System.out.println(st);
        System.out.println(st.peek()+ " " + st.size());
        st.pop();
        System.out.println(st.peek()+ " " + st.size());
        st.pop();
        st.pop();
        st.pop();
        System.out.println(st + "-> " + st.size());
    }
}
